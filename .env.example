SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Необязательные настройки (значения по умолчанию указаны справа)
# NUM_PROXIES=0              # число доверенных прокси перед приложением (за nginx: 1)
# BEHIND_HTTPS_PROXY=False   # True, если прокси выставляет X-Forwarded-Proto
# SECURE_SSL_REDIRECT=True   # действует только при DEBUG=False
# SECURE_HSTS_SECONDS=31536000
# MEDIA_ROOT=<BASE_DIR>/media
